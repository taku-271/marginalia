    "aws-amplify": "^6.22.2",
    "aws-jwt-verify": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
