{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "読書アウトプットMVP: プロンプト(P1〜P3)とイベントログ",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
